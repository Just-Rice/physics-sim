{
  "name": "physics-sim",
  "productName": "Physics Sim",
  "version": "0.1.0",
  "description": "Interactive physics sandbox with rigid bodies, cloth, soft bodies, fluids, orbital gravity and a path-traced renderer.",
  "private": true,
  "type": "module",
  "main": "desktop-dist/main.cjs",
  "author": "Just-Rice",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "desktop:build": "tsc -p desktop/tsconfig.json",
    "desktop": "npm run build && npm run desktop:build && electron .",
    "dist:mac": "npm run build && npm run desktop:build && electron-builder --mac",
    "dist:dir": "npm run build && npm run desktop:build && electron-builder --dir"
  },
  "devDependencies": {
    "@dimforge/rapier3d-compat": "^0.21.0",
    "@types/node": "^22.20.5",
    "@types/three": "^0.187.0",
    "coi-serviceworker": "^0.1.7",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "idb-keyval": "^6.3.0",
    "lil-gui": "^0.21.0",
    "three": "^0.187.0",
    "three-gpu-pathtracer": "^0.0.27",
    "three-mesh-bvh": "^0.9.17",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "zod": "^4.6.7"
  },
  "homepage": "https://github.com/Just-Rice/physics-sim",
  "repository": {
    "type": "git",
    "url": "https://github.com/Just-Rice/physics-sim.git"
  }
}
